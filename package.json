{
  "name": "icd10-browser",
  "version": "0.4.0",
  "private": true,
  "description": "ICD-10 2010 Version Browser (EN + Indonesia) — sejenis eComPress Viewer / Wd2Cn.",
  "main": "electron/main.js",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "dev": "next dev -p 3001",
    "dev:lan": "next dev -H 0.0.0.0 -p 3001",
    "build": "node scripts/build-data.mjs && next build && node scripts/obfuscate.mjs && node scripts/csp-hashes.mjs",
    "start": "next start -p 3001",
    "lint": "next lint",
    "icon:desktop": "node scripts/make-desktop-icon.mjs",
    "smoke": "node scripts/smoke.mjs",
    "keys:test": "node scripts/select-keys.mjs test",
    "keys:candidate": "node scripts/select-keys.mjs candidate",
    "keys:prod": "node scripts/select-keys.mjs production",
    "test:trust": "node scripts/trust-selftest.mjs",
    "test:keysets": "node scripts/keyset-guard-test.mjs",
    "test:license": "node license-server/test/run-tests.mjs && node license-server/test/run-ops-tests.mjs && node license-server/test/run-backup-tests.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:fuses": "node scripts/verify-fuses.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "desktop": "npm run keys:test && electron .",
    "build:desktop": "npm run keys:prod && npm run icon:desktop && npm run build && electron-builder --win --x64",
    "build:desktop:candidate": "npm run keys:candidate && npm run icon:desktop && npm run build && electron-builder --win --x64",
    "build:desktop:test": "npm run keys:test && npm run icon:desktop && npm run build && electron-builder --win --x64 --config.directories.output=dist-test",
    "dist:desktop": "npm run build:desktop"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "lucide-react": "^1.56.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^20.16.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^4.2.2",
    "postcss": "8.5.32",
    "typescript": "^5.6.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "build": {
    "appId": "id.ruangpmik.icd10codex",
    "productName": "ICD-10 Codex 2010",
    "artifactName": "ICD10-Codex-Setup-${version}.${ext}",
    "files": [
      "electron/**/*",
      "!electron/keysets/**",
      "out/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
