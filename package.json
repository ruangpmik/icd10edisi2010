{
  "name": "icd10-browser",
  "version": "0.1.0",
  "private": true,
  "description": "ICD-10 2010 Version Browser (EN + Indonesia) — sejenis eComPress Viewer / Wd2Cn.",
  "main": "electron/main.js",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "dev": "next dev -p 3001",
    "dev:lan": "next dev -H 0.0.0.0 -p 3001",
    "build": "node scripts/build-data.mjs && next build && node scripts/obfuscate.mjs",
    "start": "next start -p 3001",
    "lint": "next lint",
    "icon:desktop": "node scripts/make-desktop-icon.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dist:desktop": "npm run icon:desktop && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "lucide-react": "^1.56.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.31",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^20.16.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^4.2.2",
    "typescript": "^5.6.3",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "id.ruangpmik.icd10browser",
    "productName": "ICD-10 2010 Browser",
    "artifactName": "ICD10-Browser-Setup-${version}.${ext}",
    "files": ["electron/**/*", "out/**/*", "package.json"],
    "asar": true,
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
